VITE_APP_NAME="Owe System Stability"
VITE_API_BASE_URL=http://localhost:8080/api
VITE_APP_ENV=development

# Gate the dashboard behind the login screen. On by default. Sign-in is stubbed
# in src/lib/auth-api.ts until the real /auth/* endpoints land, so any credentials
# get you in. Set to 'false' to skip the login wall while working on the dashboard.
# VITE_REQUIRE_AUTH=false

# Real-time health-status SSE stream (receive-only, browser-native EventSource).
# SSE lives on the SAME origin as the REST API, at /sse/status. If VITE_SSE_URL
# is set it is used verbatim (absolute, or "/sse/status" for same-origin behind
# a reverse proxy). Otherwise it is derived from VITE_API_BASE_URL's origin.
# VITE_SSE_URL=http://localhost:8080/sse/status

# Live transport is SSE. Set to 'rest' to force the debug REST poller instead
# (for hosts that can't hold a long-lived stream, e.g. Vercel). VITE_STATUS_POLL_MS
# sets the poll interval (default 30000).
# VITE_STATUS_TRANSPORT=rest
# VITE_STATUS_POLL_MS=30000

# ── Credential manager (owe-stability-service) ──────────────────────────────
# Used verbatim, so the browser calls the backend directly:
#   POST <this>/credential-manager/create-credential
# Requires the service to answer CORS preflights from the page's origin. If it
# does not, set this to the same-origin prefix `/stability` instead — the Vite
# dev server and the Vercel rewrite both forward /stability/* to
# VITE_STABILITY_SERVICE_ORIGIN/api/owe-stability-service/*.
VITE_STABILITY_SERVICE_URL=http://149.28.112.32:28753/api/owe-stability-service
VITE_STABILITY_SERVICE_ORIGIN=http://149.28.112.32:28753

# RSA-OAEP 3072 keypair used to encrypt credential secrets in the browser before
# they are sent as `encrypted_secret`. Without the public key the create form
# refuses to submit. Generate a pair with:
#
#   node scripts/gen-credential-keys.mjs
#
# and paste both printed lines here. Rotating them makes every already-stored
# encrypted_secret unrecoverable.
VITE_CREDENTIAL_PUBLIC_KEY=

# TEMPORARY: read only by src/lib/crypto/secret-decrypt.ts, so the encrypt →
# decrypt round trip can be verified locally. A Vite env var is compiled into the
# public bundle, so this must stay out of production; it moves to a Cloudflare
# Worker holding the key behind an authenticated decrypt route.
VITE_CREDENTIAL_PRIVATE_KEY=
