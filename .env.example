VITE_APP_NAME="Owe System Stability"
VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_ENV=development

# Real-time health-status WebSocket (receive-only).
# If VITE_WS_URL is set, it is used verbatim (e.g. ws://149.28.112.32:3001/ws/status).
# Otherwise the URL is derived from VITE_API_BASE_URL's host (http→ws / https→wss)
# using VITE_WS_PORT (default 3001) and the /ws/status path.
# VITE_WS_URL=ws://localhost:3001/ws/status
VITE_WS_PORT=3001

# Live transport: 'ws' (default) or 'rest'. 'rest' polls the REST status
# endpoints through the Vite dev proxy — a fallback for when the WS is
# unreachable. VITE_STATUS_POLL_MS sets the poll interval (default 30000).
# VITE_STATUS_TRANSPORT=ws
# VITE_STATUS_POLL_MS=30000
