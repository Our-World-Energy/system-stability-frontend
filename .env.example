VITE_APP_NAME="Owe System Stability"
VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_ENV=development

# Real-time health-status SSE stream (receive-only, browser-native EventSource).
# If VITE_SSE_URL is set it is used verbatim (absolute, or "/sse/status" for
# same-origin behind a reverse proxy). Otherwise the URL is derived from
# VITE_API_BASE_URL's host using VITE_SSE_PORT (default 3001) and /sse/status.
# VITE_SSE_URL=http://localhost:3001/sse/status
VITE_SSE_PORT=3001

# Live transport is SSE. Set to 'rest' to force the debug REST poller instead
# (for hosts that can't hold a long-lived stream, e.g. Vercel). VITE_STATUS_POLL_MS
# sets the poll interval (default 30000).
# VITE_STATUS_TRANSPORT=rest
# VITE_STATUS_POLL_MS=30000
