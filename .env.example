VITE_APP_NAME="Owe System Stability"
VITE_API_BASE_URL=http://localhost:8080/api
VITE_APP_ENV=development

# Gate the dashboard behind the login screen. On by default. Sign-in is stubbed
# in src/lib/auth-api.ts until the real /auth/* endpoints land, so any credentials
# get you in. Set to 'false' to skip the login wall while working on the dashboard.
# VITE_REQUIRE_AUTH=false

# Real-time health-status SSE stream (receive-only, browser-native EventSource).
# SSE lives on the SAME origin as the REST API, at /sse/status. If VITE_SSE_URL
# is set it is used verbatim (absolute, or "/sse/status" for same-origin behind
# a reverse proxy). Otherwise it is derived from VITE_API_BASE_URL's origin.
# VITE_SSE_URL=http://localhost:8080/sse/status

# Live transport is SSE. Set to 'rest' to force the debug REST poller instead
# (for hosts that can't hold a long-lived stream, e.g. Vercel). VITE_STATUS_POLL_MS
# sets the poll interval (default 30000).
# VITE_STATUS_TRANSPORT=rest
# VITE_STATUS_POLL_MS=30000
