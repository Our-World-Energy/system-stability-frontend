VITE_APP_NAME="Owe System Stability"
VITE_APP_ENV=production

# Backend reached same-origin through the nginx /api proxy.
VITE_API_BASE_URL=/api

# Use the real-time WebSocket in production, same-origin via the nginx reverse
# proxy (browser → :80 → nginx → localhost:3001). Works for any client, no
# firewall/port exposure needed. Leading "/" => resolveWsUrl() builds
# ws(s)://<page-host>/ws/status automatically.
VITE_STATUS_TRANSPORT=ws
VITE_WS_URL=/ws/status
