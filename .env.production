VITE_APP_NAME="Owe System Stability"
VITE_APP_ENV=production

# Backend reached same-origin through the /api proxy (vercel.json rewrite).
VITE_API_BASE_URL=/api

# SSE is the live transport, BUT on Vercel we keep the REST poller because
# Vercel can't reliably hold a long-lived SSE stream through its rewrite proxy,
# and an https page can't open an http:// EventSource (mixed content). On a
# stream-capable host (nginx/direct), drop this line and set VITE_SSE_URL below.
VITE_STATUS_TRANSPORT=rest
VITE_STATUS_POLL_MS=30000

# SSE endpoint (used when VITE_STATUS_TRANSPORT is not 'rest').
# Same-origin via a reverse-proxy is required on https hosts to avoid mixed content.
VITE_SSE_URL=/sse/status

# ── Credential manager (owe-stability-service) ──────────────────────────────
# Reached same-origin through the /stability rewrite in vercel.json, which
# forwards to http://149.28.112.32:28753/api/owe-stability-service/*.
#
# Unlike local development this cannot be the absolute backend URL: an https page
# is not allowed to call an http:// origin (mixed content), so the rewrite is
# doing real work here, not just dodging CORS.
VITE_STABILITY_SERVICE_URL=/stability

# Public half of the RSA-OAEP keypair that encrypts credential secrets in the
# browser. Set this in the host's environment settings — until it is set, the
# create-credential form stays disabled and says so.
#
# VITE_CREDENTIAL_PRIVATE_KEY is deliberately absent: a Vite env var ends up in
# the public bundle, so the private half must never be part of a production
# build. Decryption belongs behind an authenticated Cloudflare Worker route.
VITE_CREDENTIAL_PUBLIC_KEY=
