VITE_APP_NAME="Owe System Stability"
VITE_APP_ENV=production

# Backend reached same-origin through the nginx /api proxy.
VITE_API_BASE_URL=/api

# Vercel deploy = REST polling (Vercel can't proxy WebSockets). The poller hits
# /api/... which vercel.json rewrites to the backend. Polls all 5 systems.
VITE_STATUS_TRANSPORT=rest
VITE_STATUS_POLL_MS=30000

# (WebSocket target, only used if transport=ws on a WS-capable host like nginx.)
VITE_WS_URL=/ws/status
